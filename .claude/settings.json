{
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env",
            "args": [
              "PYTHONPYCACHEPREFIX=/var/tmp/emanuele-pycache",
              "python3",
              "/home/itec/emanuele/.agent-rules/scripts/guard-wait-loop.py"
            ]
          },
          {
            "type": "command",
            "command": "/usr/bin/env",
            "args": [
              "PYTHONPYCACHEPREFIX=/var/tmp/emanuele-pycache",
              "python3",
              "/home/itec/emanuele/.agent-rules/scripts/guard-git.py"
            ]
          },
          {
            "type": "command",
            "command": "/usr/bin/env",
            "args": [
              "PYTHONPYCACHEPREFIX=/var/tmp/emanuele-pycache",
              "python3",
              "/home/itec/emanuele/.agent-rules/scripts/guard-rm.py"
            ]
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env",
            "args": [
              "PYTHONPYCACHEPREFIX=/var/tmp/emanuele-pycache",
              "python3",
              "/home/itec/emanuele/.agent-rules/scripts/guard-model-family.py"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/itec/emanuele/.agent-rules/scripts/claude/session-start.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/itec/emanuele/.agent-rules/scripts/claude/stop.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/itec/emanuele/.agent-rules/scripts/claude/user-prompt-submit.py"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/itec/emanuele/.agent-rules/scripts/claude/pre-compact.py"
          }
        ]
      }
    ]
  },
  "effortLevel": "medium",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git revert:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git reset:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git worktree:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run:*)",
      "Bash(gh issue:*)"
    ]
  }
}
