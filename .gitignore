# Allowlist-only .gitignore: this repo tracks exactly the shared coding-agent
# rules files and nothing else in this home directory. Ignore everything by
# default, then un-ignore only the specific paths we want tracked.
#
# NEVER `git add -A` or `git add .` in this repo — always add the exact
# allowlisted paths below. This directory holds real credentials
# (.ssh, .git-credentials, .gsutil, .pki, .config/gh/hosts.yml, .claude.json,
# .claude/projects/ transcripts, etc.) that must never enter this repo.

/*
!/.gitignore

!/.agent-rules
!/.agent-rules/**

# Host rules for a Cursor session opened on this directory. A relative symlink
# to .agent-rules/AGENTS.md, so it survives a clone; the absolute-path symlinks
# (~/.gemini/AGENTS.md, ~/.codex/AGENTS.md) are the installer's job, not git's.
!/AGENTS.md

# Guard values for sessions rooted here, read by every agent's hook adapter.
!/.agent-guards.json

!/.claude
/.claude/*
!/.claude/CLAUDE.md
!/.claude/settings.json

!/.gemini
/.gemini/*
!/.gemini/GEMINI.md

# Cursor has no user-level rules file, but it does have user-level hooks.
!/.cursor
/.cursor/*
!/.cursor/hooks.json
